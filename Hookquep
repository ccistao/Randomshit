local WEBHOOK_URL = "https://discord.com/api/webhooks/1483712417325387865/ah8qDn4jsy176oJ-_QG8isKPyIehRwg2DRTFhO2OYkAfURtNNVSquKfozdIgCax5hEKX"
local genv = (getgenv and getgenv()) or _G

if genv.ExFTF_WebhookLogged == game.JobId then
    return
end
genv.ExFTF_WebhookLogged = game.JobId

task.spawn(function()
    local cloneref = cloneref or function(o) return o end
    local HttpService = cloneref(game:GetService("HttpService"))
    local Players = cloneref(game:GetService("Players"))
    local MarketplaceService = cloneref(game:GetService("MarketplaceService"))
    local UserInputService = cloneref(game:GetService("UserInputService"))
    local Stats = cloneref(game:GetService("Stats"))
    local Workspace = cloneref(game:GetService("Workspace"))

    local LocalPlayer = Players.LocalPlayer
    if not LocalPlayer then
        LocalPlayer = Players.PlayerAdded:Wait()
    end

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not httpRequest then
        return
    end

    local executorName = "Unknown"
    local executorVersion = ""
    if identifyexecutor then
        local name, ver = identifyexecutor()
        executorName = name or "Unknown"
        executorVersion = ver and (" " .. tostring(ver)) or ""
    elseif getexecutorname then
        executorName = getexecutorname()
    end

    local deviceType = "💻 PC"
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        deviceType = "📱 Mobile"
    elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
        deviceType = "🎮 Console / Gamepad"
    end

    local pingValue = 0
    pcall(function()
        pingValue = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)

    local fpsValue = math.floor(Workspace:GetRealPhysicsFPS())

    local gameName = "Unknown Game"
    pcall(function()
        local info = MarketplaceService:GetProductInfo(game.PlaceId)
        if info and info.Name then
            gameName = info.Name
        end
    end)

    local ftfStatsText = "Không xác định"
    pcall(function()
        local tempStats = LocalPlayer:FindFirstChild("TempStats")
        local savedStats = LocalPlayer:FindFirstChild("SavedPlayerStats")
        if tempStats or savedStats then
            local folder = savedStats or tempStats
            local lvl = folder:FindFirstChild("Level") and folder.Level.Value or "?"
            local creds = folder:FindFirstChild("Credits") and folder.Credits.Value or "?"
            ftfStatsText = string.format("⭐ Level: `%s` | 💰 Credits: `%s`", tostring(lvl), tostring(creds))
        end
    end)

    local avatarUrl = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=420&height=420&format=png"
    pcall(function()
        local thumbRes = httpRequest({
            Url = string.format("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=%d&size=420x420&format=Png&isCircular=false", LocalPlayer.UserId),
            Method = "GET"
        })
        if thumbRes and thumbRes.Body then
            local decoded = HttpService:JSONDecode(thumbRes.Body)
            if decoded and decoded.data and decoded.data[1] and decoded.data[1].imageUrl then
                avatarUrl = decoded.data[1].imageUrl
            end
        end
    end)

    local unixNow = os.time()
    local vnTime = os.date("!*t", unixNow + (7 * 3600))
    local vnTimeString = string.format("%02d:%02d:%02d - %02d/%02d/%04d", vnTime.hour, vnTime.min, vnTime.sec, vnTime.day, vnTime.month, vnTime.year)
    local isoTimestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", unixNow)

    local joinScript = string.format('game:GetService("TeleportService"):TeleportToPlaceInstance(%d, "%s", game.Players.LocalPlayer)', game.PlaceId, game.JobId)

    local embedData = {
        username = "ExFTF V2 VIPPRO Logger",
        avatar_url = "https://i.imgur.com/AfFp7pu.png",
        embeds = {
            {
                author = {
                    name = "⚡ ExFTF V2 VIPPRO — Execution Log",
                    url = "https://www.roblox.com/users/" .. tostring(LocalPlayer.UserId) .. "/profile"
                },
                title = string.format("👤 %s (@%s)", LocalPlayer.DisplayName, LocalPlayer.Name),
                url = "https://www.roblox.com/users/" .. tostring(LocalPlayer.UserId) .. "/profile",
                description = "🟢 Người chơi vừa kích hoạt script **ExFTF V2 VIPPRO** thành công!",
                color = 0x00E5FF,
                thumbnail = { url = avatarUrl },
                fields = {
                    {
                        name = "🪪 Thông tin Tài khoản",
                        value = string.format("**User:** `%s`\n**UserID:** `%d`\n**Tuổi Acc:** `%d ngày`", LocalPlayer.Name, LocalPlayer.UserId, LocalPlayer.AccountAge),
                        inline = true
                    },
                    {
                        name = "⚙️ Thiết bị & Executor",
                        value = string.format("**Executor:** `%s%s`\n**Thiết bị:** %s\n**Hiệu năng:** `%d FPS` | `%d ms`", executorName, executorVersion, deviceType, fpsValue, pingValue),
                        inline = true
                    },
                    {
                        name = "🎮 Thông tin Phòng (Server)",
                        value = string.format("**Game:** %s\n**Sĩ số:** `%d/%d người`\n**FTF Stats:** %s", gameName, #Players:GetPlayers(), Players.MaxPlayers, ftfStatsText),
                        inline = false
                    },
                    {
                        name = "🕒 Thời gian kích hoạt",
                        value = string.format("**Giờ VN:** `%s`\n**Discord:** <t:%d:F> (<t:%d:R>)", vnTimeString, unixNow, unixNow),
                        inline = false
                    },
                    {
                        name = "🚀 Lệnh Join Nhanh Server Này",
                        value = "```lua\n" .. joinScript .. "\n```",
                        inline = false
                    }
                },
                footer = { text = "ExFTF V2 VIPPRO Security • JobId: " .. tostring(game.JobId) },
                timestamp = isoTimestamp
            }
        }
    }

    pcall(function()
        httpRequest({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(embedData)
        })
    end)
end)
