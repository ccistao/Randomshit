cat > ~/farm.sh << 'EOF'
#!/system/bin/sh
PLACE_ID="2753915549"
DISCORD_USER_ID="982107241371013132"
FILTER="roblox|delta|aya"
CHECK_INTERVAL=30
REPORT_EVERY=10
LAUNCH_WAIT=25
NET_RECHECK=15
MIN_RAM=300          # MB, duoi muc nay se canh bao
MAX_TEMP=45          # do C, tren muc nay se canh bao
BAT_LOW=20           # % pin, duoi muc nay (va khong sac) se canh bao
WH_FILE="/data/local/tmp/.wh"
STATE="/data/local/tmp/farmstate"

WEBHOOK_URL=$(base64 -d "$WH_FILE" 2>/dev/null || toybox base64 -d "$WH_FILE" 2>/dev/null)
if [ -z "$WEBHOOK_URL" ]; then
    echo "Khong doc duoc webhook!"
    exit 1
fi

LIST_CLONE=$(pm list packages -3 | cut -d: -f2 | grep -iE "$FILTER")
if [ -z "$LIST_CLONE" ]; then
    echo "Khong tim thay clone nao!"
    exit 1
fi
TOTAL_CLONE=$(echo "$LIST_CLONE" | wc -l)
echo "Da nhan dien $TOTAL_CLONE tab:"
echo "$LIST_CLONE"

mkdir -p "$STATE"
rm -f "$STATE"/min_*

START=$(date +%s)
PREV_TOT=""
PREV_IDLE=0
CPU=0
DTOT=1
TOTAL_REJOIN=0
LAST_ALERT=-100
MEM=0; BAT=0; TEMP=0; CHG=""; UPTXT="0h0m"

sys_stats() {
    local RAW ST U
    MEM=$(awk '/MemAvailable/{printf "%d", $2/1024}' /proc/meminfo)
    BAT=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null); BAT=${BAT:-0}
    RAW=$(cat /sys/class/power_supply/battery/temp 2>/dev/null); TEMP=$(( ${RAW:-0} / 10 ))
    ST=$(cat /sys/class/power_supply/battery/status 2>/dev/null)
    CHG=""; [ "$ST" = "Charging" ] && CHG="(sac)"
    U=$(( $(date +%s) - START ))
    UPTXT="$((U/3600))h$(((U%3600)/60))m"
}

send_discord() { # $1=ping $2=mau $3=tieu de $4=mo ta
    local TIME_NOW JSON FIELDS RESP CODE
    sys_stats
    TIME_NOW=$(date +"%H:%M:%S")
    FIELDS="[{\"name\":\"CPU\",\"value\":\"${CPU:-0}%\",\"inline\":true},{\"name\":\"RAM trong\",\"value\":\"${MEM}MB\",\"inline\":true},{\"name\":\"Pin\",\"value\":\"${BAT}% ${CHG}\",\"inline\":true},{\"name\":\"Nhiet do\",\"value\":\"${TEMP}C\",\"inline\":true},{\"name\":\"Uptime\",\"value\":\"$UPTXT\",\"inline\":true},{\"name\":\"Tong rejoin\",\"value\":\"$TOTAL_REJOIN\",\"inline\":true}]"
    JSON="{\"content\":\"$1\",\"embeds\":[{\"title\":\"$3\",\"description\":\"$4\",\"color\":$2,\"fields\":$FIELDS,\"footer\":{\"text\":\"$TIME_NOW\"}}]}"
    RESP=$(curl -s -4 --connect-timeout 5 -m 15 --retry 2 \
        -H "Content-Type: application/json" -X POST -d "$JSON" \
        -w "\n%{http_code}" "$WEBHOOK_URL" 2>&1)
    CODE=$(echo "$RESP" | tail -n 1)
    if [ "$CODE" = "204" ] || [ "$CODE" = "200" ]; then
        echo "[Discord] Gui OK luc $TIME_NOW"
    else
        echo "[Discord] LOI HTTP $CODE: $(echo "$RESP" | head -n 1)"
    fi
}

launch_app() {
    am start -a android.intent.action.VIEW -p "$1" -d "roblox://experiences/start?placeId=$PLACE_ID" > /dev/null 2>&1
}

get_pid() {
    local P
    P=$(pidof "$1" 2>/dev/null | awk '{print $1}')
    if [ -z "$P" ]; then
        P=$(pgrep -f "^$1" 2>/dev/null | head -n 1)
    fi
    echo "$P"
}

has_net() {
    awk -v u="$1" 'NR>1 && $8==u {f=1} END{exit !f}' /proc/net/udp /proc/net/udp6 2>/dev/null
}

cpu_total() {
    read -r _ u n s i io irq sirq st _ < /proc/stat
    TOT=$((u+n+s+i+io+irq+sirq+st)); IDLE=$((i+io))
    if [ -n "$PREV_TOT" ]; then
        DTOT=$((TOT - PREV_TOT))
        [ "$DTOT" -le 0 ] && DTOT=1
        CPU=$(( 100 * (DTOT - (IDLE - PREV_IDLE)) / DTOT ))
    else
        CPU=0; DTOT=1
    fi
    PREV_TOT=$TOT; PREV_IDLE=$IDLE
}

# Chay nen: tab nao bi thu nho (mat surface) thi mo lai, dem so lan vao file
watch_visible() {
    local W a IDX C
    while true; do
        W=$(dumpsys window windows 2>/dev/null)
        IDX=1
        for a in $LIST_CLONE; do
            if [ -n "$(get_pid "$a")" ]; then
                if ! echo "$W" | grep -A40 "u0 $a/com.roblox.client.ActivityNativeMain" | grep -q "mHasSurface=true"; then
                    echo "$(date +%T) [THU NHO] Tab $IDX ($a) -> mo lai"
                    C=$(cat "$STATE/min_$IDX" 2>/dev/null)
                    echo $(( ${C:-0} + 1 )) > "$STATE/min_$IDX"
                    monkey -p "$a" -c android.intent.category.LAUNCHER 1 > /dev/null 2>&1
                    sleep 3
                fi
            fi
            IDX=$((IDX + 1))
        done
        sleep 3
    done
}

trap 'kill $WATCH_PID 2>/dev/null; send_discord "<@$DISCORD_USER_ID>" 9807270 "SCRIPT DA DUNG" "Script bi dung."; exit 0' INT TERM

send_discord "" 3447003 "SCRIPT KHOI DONG" "Dang canh $TOTAL_CLONE tab." &
echo "--- BAT DAU CANH TAB ---"

watch_visible &
WATCH_PID=$!

LOOP_COUNT=0

while true; do
    ONLINE_COUNT=0
    STATUS_TEXT=""
    INDEX=1
    cpu_total
    sys_stats

    for app in $LIST_CLONE; do
        eval "CNT=\${CNT_$INDEX:-0}"
        MINC=$(cat "$STATE/min_$INDEX" 2>/dev/null); MINC=${MINC:-0}
        PID=$(get_pid "$app")

        if [ -z "$PID" ]; then
            echo "[!] Tab $INDEX ($app) bi vang. Mo lai..."
            CNT=$((CNT + 1)); eval "CNT_$INDEX=$CNT"
            TOTAL_REJOIN=$((TOTAL_REJOIN + 1))
            eval "PT_$INDEX="
            send_discord "<@$DISCORD_USER_ID>" 1515833
